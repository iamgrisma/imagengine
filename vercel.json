{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "api/fonts/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api?__path=$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, If-None-Match" },
        { "key": "Access-Control-Expose-Headers", "value": "ETag, Cache-Control, X-Render-Engine, X-Origin-Host" }
      ]
    }
  ]
}
