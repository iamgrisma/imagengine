{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "api/fonts/**"
    }
  },
  "rewrites": [
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/wiki/:slug.:ext(png|webp|jpg|jpeg)", "destination": "/api/index.js?folder=wiki&slug=:slug&format=:ext" },
    { "source": "/election/:slug.:ext(png|webp|jpg|jpeg)", "destination": "/api/index.js?folder=election&slug=:slug&format=:ext" },
    { "source": "/:folder/:slug.:ext(png|webp|jpg|jpeg)", "destination": "/api/index.js?folder=:folder&slug=:slug&format=:ext" },
    { "source": "/:slug.:ext(png|webp|jpg|jpeg)", "destination": "/api/index.js?slug=:slug&format=:ext" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, If-None-Match" },
        { "key": "Access-Control-Expose-Headers", "value": "ETag, Cache-Control" }
      ]
    }
  ]
}
