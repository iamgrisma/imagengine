{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "api/fonts/**"
    }
  },
  "redirects": [
    { "source": "/", "destination": "https://imagengine.grisma.info.np/", "permanent": false },
    { "source": "/docs", "destination": "https://imagengine.grisma.info.np/docs", "permanent": false },
    { "source": "/integration", "destination": "https://imagengine.grisma.info.np/integration", "permanent": false },
    { "source": "/terms", "destination": "https://imagengine.grisma.info.np/terms", "permanent": false },
    { "source": "/privacy", "destination": "https://imagengine.grisma.info.np/privacy", "permanent": false }
  ],
  "rewrites": [
    { "source": "/engine.js", "destination": "/engine.js" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, If-None-Match" },
        { "key": "Access-Control-Expose-Headers", "value": "ETag, Cache-Control" }
      ]
    }
  ]
}
