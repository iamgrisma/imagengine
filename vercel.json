{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "api/fonts/**"
    }
  },
  "rewrites": [
    { "source": "/raw/(.*)", "destination": "/api" },
    { "source": "/p/(.*)", "destination": "/api" },
    { "source": "/(.*)\\.(webp|png|jpg|jpeg)", "destination": "/api?path=$1&format=$2" },
    { "source": "/(.*)", "destination": "/api?path=$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, If-None-Match" },
        { "key": "Access-Control-Expose-Headers", "value": "ETag, Cache-Control" }
      ]
    }
  ]
}
